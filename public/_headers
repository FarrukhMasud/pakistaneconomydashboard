# Cloudflare Pages cache rules.
# Keep the entry point and data files always-fresh so updated economic data
# (committed to git → auto-deployed) is picked up immediately. Hashed asset
# filenames change on every build, so they can be cached forever.

/index.html
  Cache-Control: no-store, must-revalidate

/data/*
  Cache-Control: no-store, must-revalidate

/api/*
  Cache-Control: no-store, must-revalidate

/feed.xml
  Cache-Control: no-store, must-revalidate

/release-manifest.json
  Cache-Control: no-store, must-revalidate

/source-evidence/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Disposition: attachment
  Content-Security-Policy: default-src 'none'; sandbox
  X-Content-Type-Options: nosniff
  Content-Type: application/octet-stream

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable
