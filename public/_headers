# Cloudflare Pages cache rules.
# Keep the entry point and data files always-fresh so updated economic data
# (committed to git → auto-deployed) is picked up immediately. Hashed asset
# filenames change on every build, so they can be cached forever.

/index.html
  Cache-Control: no-store, must-revalidate

/data/*
  # App requests append ?v=<git sha>; short cache is safe and helps the SW offline fallback.
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/api/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/feed.xml
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable
